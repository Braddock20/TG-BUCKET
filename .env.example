# Get these from https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=abcdef0123456789abcdef0123456789

# Phone number with country code, e.g. +15551234567
TG_PHONE=+15551234567

# Encryption passphrase (use a strong one!)
TG_BUCKET_PASSPHRASE=change-me-to-a-long-random-string

# Optional: target channel @username or numeric ID. If omitted, uses "Saved Messages".
# TG_BUCKET_CHANNEL=@my_private_bucket
